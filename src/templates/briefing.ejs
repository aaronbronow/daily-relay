<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script>
        (function() {
            const theme = localStorage.getItem('theme');
            if (theme) {
                document.documentElement.setAttribute('data-theme', theme);
            } else {
                const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                document.documentElement.setAttribute('data-theme', prefersDark ? 'dark' : 'light');
            }
        })();
    </script>
    <title><%= briefing.title %></title>
    <style>
        :root {
            --bg-color: #ffffff;
            --text-color: #333333;
            --header-border: #eeeeee;
            --section-margin: 2.5rem;
            --article-bg: #f9f9f9;
            --article-shadow: rgba(0,0,0,0.1);
            --h2-color: #222222;
            --h2-border: #007bff;
            --h3-color: #444444;
            --hr-border: #dddddd;
            --link-color: #007bff;
            --one-liner-bg: #f1f3f5;
            --stream-bg: #fdfdfd;
            --stream-border: #cccccc;
            --narrative-bg: #ffffff;
            --narrative-border: #6c757d;
            --narrative-h4: #666666;
            --warning-bg: #fff3cd;
            --warning-text: #856404;
            --warning-border: #ffeeba;
            --footer-text: #777777;
            --menu-bg: #ffffff;
            --menu-shadow: rgba(0,0,0,0.15);
            --mindset-card-bg: rgba(0, 0, 0, 0.02);
            --mindset-card-border: rgba(0, 0, 0, 0.08);
            --mindset-bar-bg: rgba(0, 0, 0, 0.06);
            --mindset-meta-color: #555555;
            --source-pill-bg: #eeeeee;
            --source-pill-text: #555555;
        }

        [data-theme="dark"] {
            --bg-color: #1a1a1a;
            --text-color: #e0e0e0;
            --header-border: #333333;
            --article-bg: #2d2d2d;
            --article-shadow: rgba(0,0,0,0.3);
            --h2-color: #ffffff;
            --h2-border: #3793ff;
            --h3-color: #cccccc;
            --hr-border: #444444;
            --link-color: #58a6ff;
            --one-liner-bg: #333333;
            --stream-bg: #222222;
            --stream-border: #444444;
            --narrative-bg: #252525;
            --narrative-border: #888888;
            --narrative-h4: #aaaaaa;
            --warning-bg: #2c2512;
            --warning-text: #ffecb5;
            --warning-border: #664d03;
            --footer-text: #999999;
            --menu-bg: #2d2d2d;
            --menu-shadow: rgba(0,0,0,0.5);
            --mindset-card-bg: rgba(255, 255, 255, 0.03);
            --mindset-card-border: rgba(255, 255, 255, 0.08);
            --mindset-bar-bg: rgba(255, 255, 255, 0.1);
            --mindset-meta-color: #aaaaaa;
            --source-pill-bg: #333333;
            --source-pill-text: #aaaaaa;
        }

        @media (prefers-color-scheme: dark) {
            :root:not([data-theme="light"]) {
                --bg-color: #1a1a1a;
                --text-color: #e0e0e0;
                --header-border: #333333;
                --article-bg: #2d2d2d;
                --article-shadow: rgba(0,0,0,0.3);
                --h2-color: #ffffff;
                --h2-border: #3793ff;
                --h3-color: #cccccc;
                --hr-border: #444444;
                --link-color: #58a6ff;
                --one-liner-bg: #333333;
                --stream-bg: #222222;
                --stream-border: #444444;
                --narrative-bg: #252525;
                --narrative-border: #888888;
                --narrative-h4: #aaaaaa;
                --warning-bg: #2c2512;
                --warning-text: #ffecb5;
                --warning-border: #664d03;
                --footer-text: #999999;
                --menu-bg: #2d2d2d;
                --menu-shadow: rgba(0,0,0,0.5);
                --mindset-card-bg: rgba(255, 255, 255, 0.03);
                --mindset-card-border: rgba(255, 255, 255, 0.08);
                --mindset-bar-bg: rgba(255, 255, 255, 0.1);
                --mindset-meta-color: #aaaaaa;
                --source-pill-bg: #333333;
                --source-pill-text: #aaaaaa;
            }
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            line-height: 1.6;
            max-width: 800px;
            margin: 0 auto;
            padding: 2rem;
            color: var(--text-color);
            background-color: var(--bg-color);
            transition: background-color 0.3s ease, color 0.3s ease;
        }
        header {
            border-bottom: 2px solid var(--header-border);
            margin-bottom: 2rem;
            position: relative;
        }
        section {
            margin-bottom: var(--section-margin);
        }
        article {
            background: var(--article-bg);
            padding: 1.5rem;
            border-radius: 8px;
            box-shadow: 0 2px 4px var(--article-shadow);
        }
        #status article {
            font-size: 0.9rem;
            line-height: 1.5;
            padding: 1.2rem;
        }
        h2 { color: var(--h2-color); border-left: 4px solid var(--h2-border); padding-left: 10px; }
        h3 { color: var(--h3-color); margin-top: 1.5rem; }
        hr {
            border: 0;
            border-top: 1px solid var(--hr-border);
            margin: 2rem 0;
        }
        ul { padding-left: 1.5rem; }
        li { margin-bottom: 0.5rem; }
        a { color: var(--link-color); text-decoration: none; }
        a:hover { text-decoration: underline; }

        .summary-container {
            margin-bottom: 2rem;
        }
        
        /* High Density RSS-style Grid UI */
        .stream-container {
            background: var(--stream-bg);
            border-radius: 8px;
            overflow: hidden;
            margin-bottom: 1.5rem;
            border: 1px solid var(--stream-border);
        }
        .rss-row {
            padding: 0.4rem 1.2rem 0.4rem 3.5rem; /* Base left margin (1.2rem) + Hanging indent (2.3rem) */
            border-bottom: 1px solid var(--header-border);
            font-size: 0.85rem;
            line-height: 1.3;
            clear: both;
            overflow: hidden; /* Clearfix */
        }
        .rss-row:hover {
            background: var(--article-bg);
        }
        .rss-row:last-child {
            border-bottom: none;
        }
        .item-metadata {
            float: left;
            width: 170px;
            margin-left: -2.3rem; /* Pull back metadata but leave the 1.2rem base margin */
            margin-right: 1.2rem;
            color: var(--footer-text);
            font-weight: 500;
            font-size: 0.7rem;
            line-height: 1.3;
            padding-top: 0.12rem; /* Nudge down to align baseline with 0.85rem / 1.3 line-height */
            display: flex;
            justify-content: flex-start;
            overflow: hidden;
        }
        .meta-source {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            flex-shrink: 1;
        }
        .meta-date {
            white-space: nowrap;
            flex-shrink: 0;
            margin-left: 0.2rem;
        }
        .item-summary {
            /* Flows naturally around the float, wraps to the 2.5rem indent */
            text-align: justify;
            hyphens: auto;
        }
        .item-summary p {
            margin: 0;
        }
        .item-summary p + p {
            margin-top: 0.4rem;
        }
        
        .warning-banner {
            background-color: var(--warning-bg);
            color: var(--warning-text);
            border: 1px solid var(--warning-border);
            padding: 1rem;
            border-radius: 8px;
            margin-bottom: 2rem;
            font-weight: bold;
            display: flex;
            align-items: center;
        }
        .warning-banner::before {
            content: "⚠️";
            margin-right: 10px;
            font-size: 1.2rem;
        }

        /* Hamburger Menu */
        .menu-toggle {
            position: absolute;
            top: 0;
            right: 0;
            background: none;
            border: none;
            font-size: 1.8rem;
            cursor: pointer;
            color: var(--text-color);
            padding: 0.5rem;
            line-height: 1;
            z-index: 1000;
        }
        .dropdown-menu {
            display: none;
            position: absolute;
            top: 3rem;
            right: 0;
            background: var(--menu-bg);
            border: 1px solid var(--header-border);
            border-radius: 8px;
            box-shadow: 0 4px 12px var(--menu-shadow);
            padding: 1rem;
            min-width: 150px;
            z-index: 999;
        }
        .dropdown-menu.show {
            display: block;
        }
        .menu-item {
            display: block;
            width: 100%;
            padding: 0.5rem;
            text-align: left;
            background: none;
            border: none;
            color: var(--text-color);
            cursor: pointer;
            font-size: 1rem;
            border-radius: 4px;
        }
        .menu-item:hover {
            background: var(--one-liner-bg);
        }

        aside {
            margin-top: 4rem;
            padding-top: 2rem;
            border-top: 2px solid var(--header-border);
            color: var(--footer-text);
        }
        details summary {
            cursor: pointer;
            font-weight: bold;
            color: var(--link-color);
            margin-bottom: 1rem;
        }
        
        footer {
            margin-top: 3rem;
            padding-top: 1rem;
            border-top: 1px solid var(--header-border);
            font-size: 0.8rem;
            color: var(--footer-text);
        }

        /* Top Row Responsive 2-Column Grid Layout */
        .top-row-grid {
            display: grid;
            grid-template-columns: 1.2fr 0.8fr;
            gap: 2rem;
            margin-bottom: var(--section-margin);
            align-items: start;
        }
        .top-row-grid > section {
            margin-bottom: 0;
        }

        /* Mindset Archetype Card Styling */
        .mindset-card {
            background: var(--mindset-card-bg);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid var(--mindset-card-border);
            border-left: 6px solid var(--mindset-accent-color, #007bff);
            border-radius: 8px;
            padding: 1.5rem;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.02);
        }
        .mindset-header {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            margin-bottom: 0.5rem;
            flex-wrap: wrap;
            gap: 0.5rem;
        }
        .mindset-title-group {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        .mindset-name {
            font-size: 1.15rem;
            font-weight: 800;
            color: var(--h2-color);
            margin: 0;
            border: none;
            padding: 0;
        }
        .mindset-focus {
            font-size: 0.72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            background: var(--mindset-accent-bg, rgba(0, 123, 255, 0.1));
            color: var(--mindset-accent-color, #007bff);
            padding: 2px 8px;
            border-radius: 4px;
        }
        .mindset-duration {
            font-size: 0.78rem;
            color: var(--mindset-meta-color);
            font-weight: 500;
        }
        .mindset-archetype {
            font-size: 0.9rem;
            line-height: 1.45;
            margin-top: 0.5rem;
            margin-bottom: 1rem;
            color: var(--text-color);
            font-style: italic;
        }
        .mindset-progress-container {
            display: flex;
            align-items: center;
            gap: 0.8rem;
            font-size: 0.78rem;
            color: var(--mindset-meta-color);
        }
        .mindset-progress-bar {
            flex-grow: 1;
            height: 6px;
            background: var(--mindset-bar-bg);
            border-radius: 3px;
            overflow: hidden;
            position: relative;
        }
        .mindset-progress-fill {
            height: 100%;
            background: var(--mindset-accent-color, #007bff);
            border-radius: 3px;
            transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .mindset-countdown {
            font-weight: 700;
            white-space: nowrap;
        }

        /* Make Grid responsive on tablet and mobile */
        @media (max-width: 768px) {
            .top-row-grid {
                grid-template-columns: 1fr;
                gap: 1.5rem;
            }
        }

        /* Custom Task List Markdown styling inside status */
        #status ul {
            list-style: none;
            padding-left: 0;
            margin-top: 0.5rem;
            margin-bottom: 0.5rem;
            display: flex;
            flex-direction: column;
            gap: 0.3rem;
        }
        #status li {
            position: relative;
            padding-left: 0.85rem;
            font-size: 0.88rem;
            font-weight: 500;
            color: var(--text-color);
            line-height: 1.35;
        }
        #status li::before {
            content: "•";
            position: absolute;
            left: 0;
            top: -0.05rem;
            color: var(--h2-border);
            font-size: 1.1rem;
            line-height: 1.35;
        }
        
        /* History Source Link styling */
        .history-source-link {
            font-size: 0.7rem;
            vertical-align: super;
            text-decoration: none;
            background-color: var(--source-pill-bg);
            padding: 2px 8px;
            border-radius: 12px;
            color: var(--source-pill-text);
            margin-left: 4px;
            transition: background-color 0.2s ease, color 0.2s ease;
            font-weight: 500;
        }
        .history-source-link:hover {
            background-color: var(--h2-border);
            color: #ffffff;
        }
    </style>
</head>
<body>
    <header>
        <h1><%= briefing.title %></h1>
        <p>Last updated: <%= briefing.timestamp %></p>
        
        <button class="menu-toggle" id="menuToggle" aria-label="Open menu">☰</button>
        <div class="dropdown-menu" id="dropdownMenu">
            <button class="menu-item" id="themeToggle">🌓 Toggle Dark Mode</button>
        </div>
    </header>

    <main>
        <!-- System Warnings -->
        <% if (briefing.systemWarning) { %>
            <div class="warning-banner" role="alert">
                <%= briefing.systemWarning %>
            </div>
        <% } %>

        <!-- Top Row Grid: History/Tasks & Mindset Card -->
        <div class="top-row-grid">
            <!-- Intro / Status Brief (History & Tasks) -->
            <section id="status">
                <article>
                    <%- briefing.brief %>
                </article>
            </section>

            <!-- Seasonal Mindset Archetype Card -->
            <% if (briefing.season && briefing.season.current) { %>
                <% const curSeason = briefing.season.current; %>
                <section id="seasonal-mindset">
                    <div class="mindset-card" style="--mindset-accent-color: <%= curSeason.color %>; --mindset-accent-bg: <%= curSeason.color %>1a;">
                        <div class="mindset-header">
                            <div class="mindset-title-group">
                                <h3 class="mindset-name"><%= curSeason.name %></h3>
                                <span class="mindset-focus"><%= curSeason.focus %></span>
                            </div>
                            <span class="mindset-duration"><%= curSeason.startDateFormatted %> – <%= curSeason.endDateFormatted %></span>
                        </div>
                        <p class="mindset-archetype">“<%= curSeason.archetype %>”</p>
                        <div class="mindset-progress-container">
                            <div class="mindset-progress-bar" title="Season Progress: <%= curSeason.progressPercent %>%">
                                <div class="mindset-progress-fill" style="width: <%= curSeason.progressPercent %>%;"></div>
                            </div>
                            <span class="mindset-countdown">
                                <% if (curSeason.remainingDays === 0) { %>
                                    Last day of the season
                                <% } else if (curSeason.remainingDays === 1) { %>
                                    1 day remaining
                                <% } else { %>
                                    <%= curSeason.remainingDays %> days remaining
                                <% } %>
                            </span>
                        </div>
                    </div>
                </section>
            <% } %>
        </div>

        <!-- Email Updates Section -->
        <% if (briefing.emailUpdates) { %>
            <section id="email-updates" aria-labelledby="email-heading">
                <h2 id="email-heading">Email Updates</h2>
                
                <% briefing.emailUpdates.forEach(siteData => { %>
                    <% const summaryData = briefing.summaries[siteData.site]; %>
                    <% if (summaryData && summaryData.items) { %>
                        <div class="stream-container">
                            <% summaryData.items.forEach(item => { %>
                                <div class="rss-row">
                                    <div class="item-metadata" title="<%= item.preamble %>">
                                        <span class="meta-source"><%= item.metaSource %></span>
                                        <span class="meta-date">• <%= item.metaDate %></span>
                                    </div>
                                    <div class="item-summary">
                                        <%- item.summary %>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } %>
                <% }) %>
            </section>
        <% } %>

        <!-- GitHub Release Updates Section -->
        <% if (briefing.githubUpdates && briefing.githubUpdates.length > 0) { %>
            <section id="github-updates" aria-labelledby="github-heading">
                <h2 id="github-heading">GitHub Release Updates</h2>
                
                <% briefing.githubUpdates.forEach(siteData => { %>
                    <% const summaryData = briefing.summaries[siteData.site]; %>
                    <% if (summaryData && summaryData.items) { %>
                        <div class="stream-container">
                            <% summaryData.items.forEach(item => { %>
                                <div class="rss-row">
                                    <div class="item-metadata" title="<%= item.preamble %>">
                                        <span class="meta-source"><%= item.metaSource %></span>
                                        <span class="meta-date">• <%= item.metaDate %></span>
                                    </div>
                                    <div class="item-summary">
                                        <%- item.summary %>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } %>
                <% }) %>
            </section>
        <% } %>

        <!-- Today's News Section -->
        <% if (briefing.todaysNews) { %>
            <section id="todays-news" aria-labelledby="news-heading">
                <h2 id="news-heading">Today's News</h2>
                
                <% briefing.todaysNews.forEach(siteData => { %>
                    <% const summaryData = briefing.summaries[siteData.site]; %>
                    <% if (summaryData && summaryData.items) { %>
                        <div class="stream-container">
                            <% summaryData.items.forEach(item => { %>
                                <div class="rss-row">
                                    <div class="item-metadata" title="<%= item.preamble %>">
                                        <span class="meta-source"><%= item.metaSource %></span>
                                        <span class="meta-date">• <%= item.metaDate %></span>
                                    </div>
                                    <div class="item-summary">
                                        <%- item.summary %>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } %>
                <% }) %>
            </section>
        <% } %>
    </main>

    <!-- Sources Section (Hiding from Reading Mode by placing outside <main>) -->
    <aside aria-label="Sources" aria-hidden="true">
        <% if (briefing.emailUpdates && briefing.emailUpdates.length > 0) { %>
            <p><a href="https://mail.google.com" target="_blank" rel="noopener noreferrer" style="font-weight: bold;">&rarr; Open Gmail</a></p>
        <% } %>
        <details>
            <summary>View Source Links</summary>
            <% const allSources = [...(briefing.githubUpdates || []), ...(briefing.todaysNews || [])]; %>
            <% allSources.forEach(siteData => { %>
                <div class="site-group">
                    <h4><%= siteData.site %></h4>
                    <ul>
                        <% siteData.items.forEach(item => { %>
                            <li>
                                <a href="<%= item.url %>" target="_blank" rel="noopener noreferrer">
                                    <%= item.title %>
                                </a>
                            </li>
                        <% }) %>
                    </ul>
                </div>
            <% }) %>
        </details>
    </aside>

    <footer>
        <p>daily-relay | Semantic briefing for TTS and Agents</p>
    </footer>

    <script>
        // Hamburger Menu Logic
        const menuToggle = document.getElementById('menuToggle');
        const dropdownMenu = document.getElementById('dropdownMenu');
        const themeToggle = document.getElementById('themeToggle');

        menuToggle.addEventListener('click', (e) => {
            e.stopPropagation();
            dropdownMenu.classList.toggle('show');
        });

        // Close menu when clicking outside
        document.addEventListener('click', () => {
            dropdownMenu.classList.remove('show');
        });

        dropdownMenu.addEventListener('click', (e) => {
            e.stopPropagation();
        });

        // Theme Toggle Logic
        themeToggle.addEventListener('click', () => {
            const currentTheme = document.documentElement.getAttribute('data-theme');
            let newTheme;

            if (currentTheme === 'dark') {
                newTheme = 'light';
            } else if (currentTheme === 'light') {
                newTheme = 'dark';
            } else {
                // If currently using system mode, detect which one is active
                const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                newTheme = prefersDark ? 'light' : 'dark';
            }

            document.documentElement.setAttribute('data-theme', newTheme);
            localStorage.setItem('theme', newTheme);
        });

        // Auto-refresh via Server-Sent Events (SSE)
        const eventSource = new EventSource('/events');
        eventSource.onmessage = function(event) {
            if (event.data === 'reload') {
                console.log('New content detected. Reloading...');
                window.location.reload();
            }
        };
        eventSource.onerror = function(err) {
            console.error('SSE connection failed:', err);
        };
    </script>
</body>
</html>
