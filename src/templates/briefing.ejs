<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= briefing.title %></title>
    <style>
        :root {
            --bg-color: #ffffff;
            --text-color: #333333;
            --header-border: #eeeeee;
            --section-margin: 2.5rem;
            --article-bg: #f9f9f9;
            --article-shadow: rgba(0,0,0,0.1);
            --h2-color: #222222;
            --h2-border: #007bff;
            --h3-color: #444444;
            --hr-border: #dddddd;
            --link-color: #007bff;
            --one-liner-bg: #f1f3f5;
            --narrative-bg: #ffffff;
            --narrative-border: #6c757d;
            --narrative-h4: #666666;
            --warning-bg: #fff3cd;
            --warning-text: #856404;
            --warning-border: #ffeeba;
            --footer-text: #777777;
            --menu-bg: #ffffff;
            --menu-shadow: rgba(0,0,0,0.15);
        }

        [data-theme="dark"] {
            --bg-color: #1a1a1a;
            --text-color: #e0e0e0;
            --header-border: #333333;
            --article-bg: #2d2d2d;
            --article-shadow: rgba(0,0,0,0.3);
            --h2-color: #ffffff;
            --h2-border: #3793ff;
            --h3-color: #cccccc;
            --hr-border: #444444;
            --link-color: #58a6ff;
            --one-liner-bg: #333333;
            --narrative-bg: #252525;
            --narrative-border: #888888;
            --narrative-h4: #aaaaaa;
            --warning-bg: #2c2512;
            --warning-text: #ffecb5;
            --warning-border: #664d03;
            --footer-text: #999999;
            --menu-bg: #2d2d2d;
            --menu-shadow: rgba(0,0,0,0.5);
        }

        @media (prefers-color-scheme: dark) {
            :root:not([data-theme="light"]) {
                --bg-color: #1a1a1a;
                --text-color: #e0e0e0;
                --header-border: #333333;
                --article-bg: #2d2d2d;
                --article-shadow: rgba(0,0,0,0.3);
                --h2-color: #ffffff;
                --h2-border: #3793ff;
                --h3-color: #cccccc;
                --hr-border: #444444;
                --link-color: #58a6ff;
                --one-liner-bg: #333333;
                --narrative-bg: #252525;
                --narrative-border: #888888;
                --narrative-h4: #aaaaaa;
                --warning-bg: #2c2512;
                --warning-text: #ffecb5;
                --warning-border: #664d03;
                --footer-text: #999999;
                --menu-bg: #2d2d2d;
                --menu-shadow: rgba(0,0,0,0.5);
            }
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            line-height: 1.6;
            max-width: 800px;
            margin: 0 auto;
            padding: 2rem;
            color: var(--text-color);
            background-color: var(--bg-color);
            transition: background-color 0.3s ease, color 0.3s ease;
        }
        header {
            border-bottom: 2px solid var(--header-border);
            margin-bottom: 2rem;
            position: relative;
        }
        section {
            margin-bottom: var(--section-margin);
        }
        article {
            background: var(--article-bg);
            padding: 1.5rem;
            border-radius: 8px;
            box-shadow: 0 2px 4px var(--article-shadow);
        }
        h2 { color: var(--h2-color); border-left: 4px solid var(--h2-border); padding-left: 10px; }
        h3 { color: var(--h3-color); margin-top: 1.5rem; }
        hr {
            border: 0;
            border-top: 1px solid var(--hr-border);
            margin: 2rem 0;
        }
        ul { padding-left: 1.5rem; }
        li { margin-bottom: 0.5rem; }
        a { color: var(--link-color); text-decoration: none; }
        a:hover { text-decoration: underline; }

        .summary-container {
            margin-bottom: 2rem;
        }
        .one-liner-list {
            background: var(--one-liner-bg);
            padding: 1rem 1.5rem;
            border-radius: 8px;
            margin-bottom: 1rem;
        }
        .one-liner-list ul { margin: 0; padding-left: 1.2rem; }
        
        /* Unified Email Stream */
        .email-stream {
            background: var(--one-liner-bg);
            border-radius: 8px;
            overflow: hidden;
            margin-bottom: 1.5rem;
        }
        .email-item {
            padding: 1.2rem 1.5rem;
            border-bottom: 1px solid var(--header-border);
        }
        .email-item:last-child {
            border-bottom: none;
        }
        .email-item.is-one-liner {
            font-size: 0.95rem;
        }
        .email-item.is-full-narrative {
            display: flex;
            flex-direction: column;
        }
        .email-item.is-full-narrative h4 {
            margin: 0 0 0.5rem 0;
            font-size: 0.9rem;
            color: var(--narrative-h4);
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
        .narrative-content {
            border-left: 3px solid var(--narrative-border);
            padding-left: 1.2rem;
            margin-left: 0.5rem;
            font-size: 0.95rem;
            line-height: 1.5;
            color: var(--text-color);
        }
        
        .warning-banner {
            background-color: var(--warning-bg);
            color: var(--warning-text);
            border: 1px solid var(--warning-border);
            padding: 1rem;
            border-radius: 8px;
            margin-bottom: 2rem;
            font-weight: bold;
            display: flex;
            align-items: center;
        }
        .warning-banner::before {
            content: "⚠️";
            margin-right: 10px;
            font-size: 1.2rem;
        }

        /* Hamburger Menu */
        .menu-toggle {
            position: absolute;
            top: 0;
            right: 0;
            background: none;
            border: none;
            font-size: 1.8rem;
            cursor: pointer;
            color: var(--text-color);
            padding: 0.5rem;
            line-height: 1;
            z-index: 1000;
        }
        .dropdown-menu {
            display: none;
            position: absolute;
            top: 3rem;
            right: 0;
            background: var(--menu-bg);
            border: 1px solid var(--header-border);
            border-radius: 8px;
            box-shadow: 0 4px 12px var(--menu-shadow);
            padding: 1rem;
            min-width: 150px;
            z-index: 999;
        }
        .dropdown-menu.show {
            display: block;
        }
        .menu-item {
            display: block;
            width: 100%;
            padding: 0.5rem;
            text-align: left;
            background: none;
            border: none;
            color: var(--text-color);
            cursor: pointer;
            font-size: 1rem;
            border-radius: 4px;
        }
        .menu-item:hover {
            background: var(--one-liner-bg);
        }

        aside {
            margin-top: 4rem;
            padding-top: 2rem;
            border-top: 2px solid var(--header-border);
            color: var(--footer-text);
        }
        details summary {
            cursor: pointer;
            font-weight: bold;
            color: var(--link-color);
            margin-bottom: 1rem;
        }
        
        footer {
            margin-top: 3rem;
            padding-top: 1rem;
            border-top: 1px solid var(--header-border);
            font-size: 0.8rem;
            color: var(--footer-text);
        }
    </style>
    <script>
        // Immediate theme application to prevent flash
        (function() {
            const savedTheme = localStorage.getItem('theme');
            if (savedTheme) {
                document.documentElement.setAttribute('data-theme', savedTheme);
            }
        })();
    </script>
</head>
<body>
    <header>
        <h1><%= briefing.title %></h1>
        <p>Last updated: <%= briefing.timestamp %></p>
        
        <button class="menu-toggle" id="menuToggle" aria-label="Open menu">☰</button>
        <div class="dropdown-menu" id="dropdownMenu">
            <button class="menu-item" id="themeToggle">🌓 Toggle Dark Mode</button>
        </div>
    </header>

    <main>
        <!-- System Warnings -->
        <% if (briefing.systemWarning) { %>
            <div class="warning-banner" role="alert">
                <%= briefing.systemWarning %>
            </div>
        <% } %>

        <!-- Intro / Status Brief -->
        <section id="status">
            <article>
                <%- briefing.brief %>
            </article>
        </section>

        <!-- Email Updates Section -->
        <% if (briefing.emailUpdates) { %>
            <section id="email-updates" aria-labelledby="email-heading">
                <h2 id="email-heading">Email Updates</h2>
                
                <% briefing.emailUpdates.forEach(siteData => { %>
                    <% const summaryData = briefing.summaries[siteData.site]; %>
                    <% if (summaryData && summaryData.items) { %>
                        <div class="email-stream">
                            <% summaryData.items.forEach(item => { %>
                                <% if (item.mode === 'full-narrative') { %>
                                    <div class="email-item is-full-narrative">
                                        <h4>Newsletter: <%= item.from %></h4>
                                        <div class="narrative-content">
                                            <%= item.text %>
                                        </div>
                                    </div>
                                <% } else { %>
                                    <div class="email-item is-one-liner">
                                        <%= item.text %>
                                    </div>
                                <% } %>
                            <% }) %>
                        </div>
                    <% } %>
                <% }) %>
            </section>
        <% } %>

        <!-- GitHub Release Updates Section -->
        <% if (briefing.githubUpdates && briefing.githubUpdates.length > 0) { %>
            <section id="github-updates" aria-labelledby="github-heading">
                <h2 id="github-heading">GitHub Release Updates</h2>
                
                <% briefing.githubUpdates.forEach(siteData => { %>
                    <% const summaryData = briefing.summaries[siteData.site]; %>
                    <% if (summaryData && summaryData.items) { %>
                        <div class="one-liner-list">
                            <ul>
                                <% summaryData.items.forEach(item => { %>
                                    <li><%= item.text %></li>
                                <% }) %>
                            </ul>
                        </div>
                    <% } %>
                <% }) %>
            </section>
        <% } %>

        <!-- Today's News Section -->
        <% if (briefing.todaysNews) { %>
            <section id="todays-news" aria-labelledby="news-heading">
                <h2 id="news-heading">Today's News</h2>
                
                <% briefing.todaysNews.forEach(siteData => { %>
                    <% const summaryData = briefing.summaries[siteData.site]; %>
                    <% if (summaryData && summaryData.items) { %>
                        <div class="summary-container">
                            <h3><%= siteData.site %></h3>
                            <div class="one-liner-list">
                                <ul>
                                    <% summaryData.items.forEach(item => { %>
                                        <li><%= item.text %></li>
                                    <% }) %>
                                </ul>
                            </div>
                        </div>
                    <% } %>
                <% }) %>
            </section>
        <% } %>
    </main>

    <!-- Sources Section (Hiding from Reading Mode by placing outside <main>) -->
    <aside aria-label="Sources" aria-hidden="true">
        <% if (briefing.emailUpdates && briefing.emailUpdates.length > 0) { %>
            <p><a href="https://mail.google.com" target="_blank" rel="noopener noreferrer" style="font-weight: bold;">&rarr; Open Gmail</a></p>
        <% } %>
        <details>
            <summary>View Source Links</summary>
            <% const allSources = [...(briefing.githubUpdates || []), ...(briefing.todaysNews || [])]; %>
            <% allSources.forEach(siteData => { %>
                <div class="site-group">
                    <h4><%= siteData.site %></h4>
                    <ul>
                        <% siteData.items.forEach(item => { %>
                            <li>
                                <a href="<%= item.url %>" target="_blank" rel="noopener noreferrer">
                                    <%= item.title %>
                                </a>
                            </li>
                        <% }) %>
                    </ul>
                </div>
            <% }) %>
        </details>
    </aside>

    <footer>
        <p>daily-relay | Semantic briefing for TTS and Agents</p>
    </footer>

    <script>
        // Hamburger Menu Logic
        const menuToggle = document.getElementById('menuToggle');
        const dropdownMenu = document.getElementById('dropdownMenu');
        const themeToggle = document.getElementById('themeToggle');

        menuToggle.addEventListener('click', (e) => {
            e.stopPropagation();
            dropdownMenu.classList.toggle('show');
        });

        // Close menu when clicking outside
        document.addEventListener('click', () => {
            dropdownMenu.classList.remove('show');
        });

        dropdownMenu.addEventListener('click', (e) => {
            e.stopPropagation();
        });

        // Theme Toggle Logic
        themeToggle.addEventListener('click', () => {
            const currentTheme = document.documentElement.getAttribute('data-theme');
            let newTheme;

            if (currentTheme === 'dark') {
                newTheme = 'light';
            } else if (currentTheme === 'light') {
                newTheme = 'dark';
            } else {
                // If currently using system mode, detect which one is active
                const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                newTheme = prefersDark ? 'light' : 'dark';
            }

            document.documentElement.setAttribute('data-theme', newTheme);
            localStorage.setItem('theme', newTheme);
        });

        // Auto-refresh via Server-Sent Events (SSE)
        const eventSource = new EventSource('/events');
        eventSource.onmessage = function(event) {
            if (event.data === 'reload') {
                console.log('New content detected. Reloading...');
                window.location.reload();
            }
        };
        eventSource.onerror = function(err) {
            console.error('SSE connection failed:', err);
        };
    </script>
</body>
</html>
